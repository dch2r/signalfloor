    "/runs/{run_id}/cases/{case_id}": {
      "get": {
        "tags": [
          "runs"
        ],
        "summary": "Get Case",
        "description": "One case's score, with its trace if the run recorded one and the spans have arrived.",
        "operationId": "get_case_runs__run_id__cases__case_id__get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Run Id"
            }
          },
          {
            "name": "case_id",
            "in": "path",
            "required": true,
