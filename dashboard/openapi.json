    },
    "/runs/{baseline_id}/compare/{candidate_id}": {
      "get": {
        "tags": [
          "runs"
        ],
        "summary": "Compare Runs",
        "description": "Paired bootstrap of candidate minus baseline, the same test as `signalfloor compare`.\n\nFor more resamples than this endpoint allows, use POST /jobs/compare.",
        "operationId": "compare_runs_runs__baseline_id__compare__candidate_id__get",
        "parameters": [
          {
            "name": "baseline_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Baseline Id"
            }
          },
          {
            "name": "candidate_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Candidate Id"
            }
          },
          {
            "name": "confidence",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "exclusiveMaximum": 1,
              "exclusiveMinimum": 0,
              "default": 0.95,
              "title": "Confidence"
            }
          },
          {
            "name": "n_resamples",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100000,
              "minimum": 100,
              "default": 10000,
              "title": "N Resamples"
            }
          },
          {
            "name": "seed",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Seed"
            }
          },
          {
            "name": "shared_only",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Compare only the cases both runs have, instead of refusing.",
              "default": false,
              "title": "Shared Only"
            },
            "description": "Compare only the cases both runs have, instead of refusing."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComparisonOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{baseline_id}/diff/{candidate_id}": {
      "get": {
        "tags": [
          "runs"
        ],
        "summary": "Diff Runs",
        "description": "How many cases got worse or better, and the `limit` biggest drops and gains.",
        "operationId": "diff_runs_runs__baseline_id__diff__candidate_id__get",
        "parameters": [
          {
            "name": "baseline_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Baseline Id"
            }
          },
          {
            "name": "candidate_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Candidate Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunDiffOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/traces": {
      "post": {
        "tags": [
          "traces"
        ],
        "summary": "Ingest",
        "description": "The OTLP/HTTP trace endpoint.",
        "operationId": "ingest_v1_traces_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/traces/{trace_id}": {
      "get": {
        "tags": [
          "traces"
        ],
        "summary": "Get Trace",
        "description": "Every span in a trace, in the order they started.",
        "operationId": "get_trace_traces__trace_id__get",
        "parameters": [
          {
            "name": "trace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Trace Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SpanOut"
                  },
                  "title": "Response Get Trace Traces  Trace Id  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/compare": {
      "post": {
        "tags": [
          "jobs"
        ],
        "summary": "Start Compare",
        "description": "Queue a comparison. Poll GET /jobs/{id} until its status is succeeded or failed.",
        "operationId": "start_compare_jobs_compare_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompareJobIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{job_id}": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Get Job",
        "operationId": "get_job_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CaseDiff": {
        "properties": {
          "case_id": {
            "type": "string",
            "title": "Case Id"
          },
          "baseline_score": {
            "type": "number",
            "title": "Baseline Score"
          },
          "candidate_score": {
            "type": "number",
            "title": "Candidate Score"
          },
          "delta": {
            "type": "number",
            "title": "Delta"
          },
          "baseline_trace_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseline Trace Id"
          },
          "candidate_trace_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Candidate Trace Id"
          }
        },
        "type": "object",
        "required": [
          "case_id",
          "baseline_score",
          "candidate_score",
          "delta",
          "baseline_trace_id",
          "candidate_trace_id"
        ],
        "title": "CaseDiff"
      },
      "CaseIn": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Id"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "trace_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trace Id"
          }
        },
        "type": "object",
        "required": [
          "id",
          "score"
        ],
        "title": "CaseIn"
      },
      "CaseOut": {
        "properties": {
          "case_id": {
            "type": "string",
            "title": "Case Id"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "trace_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trace Id"
          },
          "spans": {
            "items": {
              "$ref": "#/components/schemas/SpanOut"
            },
            "type": "array",
            "title": "Spans"
          }
        },
        "type": "object",
        "required": [
          "case_id",
          "score",
          "trace_id",
          "spans"
        ],
        "title": "CaseOut"
      },
      "CompareJobIn": {
        "properties": {
          "baseline_id": {
            "type": "string",
            "format": "uuid",
            "title": "Baseline Id"
          },
          "candidate_id": {
            "type": "string",
            "format": "uuid",
            "title": "Candidate Id"
          },
          "confidence": {
            "type": "number",
            "exclusiveMaximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Confidence",
            "default": 0.95
          },
          "n_resamples": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 100.0,
            "title": "N Resamples",
            "default": 100000
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          },
          "shared_only": {
            "type": "boolean",
            "title": "Shared Only",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "baseline_id",
          "candidate_id"
        ],
        "title": "CompareJobIn"
      },
      "ComparisonOut": {
        "properties": {
          "baseline_id": {
            "type": "string",
            "format": "uuid",
            "title": "Baseline Id"
          },
          "candidate_id": {
            "type": "string",
            "format": "uuid",
            "title": "Candidate Id"
          },
          "baseline_mean": {
            "type": "number",
            "title": "Baseline Mean"
          },
          "candidate_mean": {
            "type": "number",
            "title": "Candidate Mean"
          },
          "delta": {
            "type": "number",
            "title": "Delta"
          },
          "ci_low": {
            "type": "number",
            "title": "Ci Low"
          },
          "ci_high": {
            "type": "number",
            "title": "Ci High"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "n_cases": {
            "type": "integer",
            "title": "N Cases"
          },
          "n_resamples": {
            "type": "integer",
            "title": "N Resamples"
          },
          "verdict": {
            "type": "string",
            "title": "Verdict"
          }
        },
        "type": "object",
        "required": [
          "baseline_id",
          "candidate_id",
          "baseline_mean",
          "candidate_mean",
          "delta",
          "ci_low",
          "ci_high",
          "confidence",
          "n_cases",
          "n_resamples",
          "verdict"
        ],
        "title": "ComparisonOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "attempts": {
            "type": "integer",
            "title": "Attempts"
          },
          "result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "status",
          "attempts",
          "result",
          "error",
          "created_at",
          "started_at",
          "finished_at"
        ],
        "title": "JobOut"
      },
      "RunDiffOut": {
        "properties": {
          "baseline_id": {
            "type": "string",
            "format": "uuid",
            "title": "Baseline Id"
          },
          "candidate_id": {
            "type": "string",
            "format": "uuid",
            "title": "Candidate Id"
          },
          "n_shared": {
            "type": "integer",
            "title": "N Shared"
          },
          "n_worse": {
            "type": "integer",
            "title": "N Worse"
          },
          "n_better": {
            "type": "integer",
            "title": "N Better"
          },
          "n_same": {
            "type": "integer",
            "title": "N Same"
          },
          "only_in_baseline": {
            "type": "integer",
            "title": "Only In Baseline"
          },
          "only_in_candidate": {
            "type": "integer",
            "title": "Only In Candidate"
          },
          "worst": {
            "items": {
              "$ref": "#/components/schemas/CaseDiff"
            },
            "type": "array",
            "title": "Worst"
          },
          "best": {
            "items": {
              "$ref": "#/components/schemas/CaseDiff"
            },
            "type": "array",
            "title": "Best"
          }
        },
        "type": "object",
        "required": [
          "baseline_id",
          "candidate_id",
          "n_shared",
          "n_worse",
          "n_better",
          "n_same",
          "only_in_baseline",
          "only_in_candidate",
          "worst",
          "best"
        ],
        "title": "RunDiffOut"
      },
      "RunIn": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "labels": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "maxProperties": 50,
            "title": "Labels"
          },
          "cases": {
            "items": {
              "$ref": "#/components/schemas/CaseIn"
            },
            "type": "array",
            "maxItems": 100000,
            "minItems": 1,
            "title": "Cases"
          }
        },
        "type": "object",
        "required": [
          "name",
          "cases"
        ],
        "title": "RunIn"
      },
      "RunOut": {
        "properties": {
          "id": {
            "type": "string",
